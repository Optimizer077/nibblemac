# pinfer kernel config fragment (applied on top of the RUNNING Pi kernel's config,
# /boot/config-6.18.50+rpt-rpi-v8). Applied by os/kernel/build.sh with
# scripts/kconfig/merge_config.sh, then `make olddefconfig`; build.sh verifies that every
# CONFIG_ line below survives olddefconfig unchanged.

# --- Identity -------------------------------------------------------------------------
CONFIG_LOCALVERSION="-pinfer"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Split-core: tickless isolated CPUs ------------------------------------------------
# Timer-tick choice: NO_HZ_FULL replaces the stock NO_HZ_IDLE. NO_HZ_FULL behaves like
# NO_HZ_IDLE on every CPU not named in nohz_full= on the cmdline, so the kernel without
# the cmdline changes behaves like stock.
# CONFIG_HZ_PERIODIC is not set
# CONFIG_NO_HZ_IDLE is not set
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_COMMON=y
# NO_HZ_FULL needs generic (context-tracking based) cputime accounting.
# CONFIG_TICK_CPU_ACCOUNTING is not set
CONFIG_VIRT_CPU_ACCOUNTING_GEN=y
CONFIG_CONTEXT_TRACKING_USER=y
# RCU callback offloading for rcu_nocbs= (selected by NO_HZ_FULL).
CONFIG_RCU_NOCB_CPU=y
# isolcpus= / housekeeping infrastructure (already =y in stock; kept explicit).
CONFIG_CPU_ISOLATION=y

# --- Huge pages for streamed weights --------------------------------------------------
# hugetlbfs: explicit 2 MB pages (hugepagesz=2M / /proc/sys/vm/nr_hugepages, MAP_HUGETLB).
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
# THP: off unless a mapping asks with madvise(MADV_HUGEPAGE) -> no behaviour change for
# other processes.
CONFIG_TRANSPARENT_HUGEPAGE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# Lets khugepaged / MADV_COLLAPSE build 2 MB page-cache folios for read-only file
# mappings (an mmap'ed, read-only model file).
CONFIG_READ_ONLY_THP_FOR_FS=y
