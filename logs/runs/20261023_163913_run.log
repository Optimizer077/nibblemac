  fi
done
printf 'Cerno paths\n'
find . -maxdepth 3 -type d -name 'cerno*' -print
printf 'Scratch directories\n'
for p in tmp/gpu-c tmp/gpu-engine tmp/csp; do if [ -d "$p" ]; then du -sh "$p"; fi; done
printf 'Existing backups\n'
find engine -maxdepth 1 -name '*.pre-v03' -print


