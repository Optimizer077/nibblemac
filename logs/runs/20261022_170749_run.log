#!/bin/bash
# 4B prefill profile: PF_FWD_STATS + PF_KERN_STATS on p64 / p256 after an untimed warm-up run.
set -o pipefail
BIN=${1:-./engine/pinfer_run_csp0}
M=models/cerno-4b-q4_0.pq
echo "bin $BIN md5 $(md5sum $BIN | cut -c1-8)"
$BIN -m $M -t 4 --ids-file tmp/csp/p64.ids -n 1 --no-warmup 2>&1 | grep -E '^load'
for f in ${PROMPTS:-p64 p256}; do
  echo "== $f freq $(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | xargs)"
  PF_FWD_STATS=1 PF_KERN_STATS=1 $BIN -m $M -t 4 --ids-file tmp/csp/$f.ids -n 1 --bench --no-warmup 2>&1 | grep -E 'RESULT|^load|STATS'
done
echo "freq_after $(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | xargs)"

[exit 0]
