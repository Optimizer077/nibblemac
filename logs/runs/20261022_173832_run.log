#!/bin/bash
# 4B prefill A/B: for each binary (comma list, in order) p64 / p256 / p512 with --bench (in-process
# warm-up), one RESULT line per run tagged with bin and prompt (from ~/pinfer).
# usage: e2e4b.sh BIN1,BIN2 ROUND [PROMPTS]
BINS=${1//,/ }; R=$2; P=${3:-p64,p256,p512}
M=models/cerno-4b-q4_0.pq
for b in $BINS; do echo "bin $b md5 $(md5sum $b | cut -c1-8)"; done
for b in $BINS; do
  for p in ${P//,/ }; do
    f0=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | xargs)
    $b -m $M -t 4 --ids-file tmp/csp/$p.ids -n 1 --bench 2>/dev/null \
      | sed -n "s|^RESULT {|RESULT {\"ab_bin\":\"$b\",\"ab_round\":$R,\"ab_prompt\":\"$p\",\"freq_khz_before\":\"$f0\",|p"
  done
done
echo "freq_after $(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | xargs) temp $(vcgencmd measure_temp 2>/dev/null)"
====
#!/bin/bash
# Qwen3.5-0.8B regression A/B on prompt64: plain decode, default speculative (adaptive k <= 4,
# draft vocab 32768, ngram 7), prefill (-n 1); ROUNDS rounds of the binaries in order.
# usage: e2e08.sh BIN1,BIN2 ROUNDS
BINS=${1//,/ }; R=${2:-3}
M=models/qwen35-0.8b-q4k-headq4k.pq
for b in $BINS; do echo "bin $b md5 $(md5sum $b | cut -c1-8)"; done
for r in $(seq 1 $R); do
  for b in $BINS; do
    for mode in plain spec prefill; do
      case $mode in
        plain) a="-n 64";; spec) a="-n 64 --spec 4 --draft-vocab 32768 --adaptive --ngram 7";;
        prefill) a="-n 1";;
      esac
      f0=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | xargs)
      $b -m $M -t 4 --ids-file data/prompt64.ids --bench $a 2>/dev/null \
        | sed -n "s|^RESULT {|RESULT {\"ab_bin\":\"$b\",\"ab_round\":$r,\"ab_mode\":\"$mode\",\"freq_khz_before\":\"$f0\",|p"
    done
  done
done
echo "freq_after $(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | xargs) temp $(vcgencmd measure_temp 2>/dev/null)"
